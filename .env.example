# Copy to .env.local (and add the same vars in Vercel → Settings → Environment Variables)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_ADSENSE_ID=

# --- Server tools (optional) ---
# Google PageSpeed API key: higher quota (free at console.cloud.google.com → enable "PageSpeed Insights API")
PAGESPEED_API_KEY=
# Self-hosted LanguageTool (unlimited): docker run -d -p 8010:8010 erikvl87/languagetool
LANGUAGETOOL_URL=
# Screenshots: leave empty to use Microlink's free API; set to "playwright" on your own server after `npm i playwright && npx playwright install chromium --with-deps`
SCREENSHOT_MODE=

# YouTube Data API v3 key (free, 10k units/day) for full video stats (likes, comments): console.cloud.google.com → enable "YouTube Data API v3"
YOUTUBE_API_KEY=
